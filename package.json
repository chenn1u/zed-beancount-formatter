{
  "name": "zed-beancount-formatter",
  "version": "1.5.0",
  "description": "Beancount formatter for Zed",
  "license": "mit",
  "author": "dongfg",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenn1u/zed-beancount-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/chenn1u/zed-beancount-formatter/issues"
  },
  "homepage": "https://github.com/chenn1u/zed-beancount-formatter#readme",
  "keywords": [
    "beancount",
    "formatter",
    "zed"
  ],
  "bin": {
    "beancount-format": "./out/cli.js"
  },
  "files": [
    "out/*.js"
  ],
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublishOnly": "yarn build",
    "test": "jest",
    "lint": "eslint --cache --ext .ts ./src",
    "lint:fix": "yarn lint --fix && yarn lint",
    "lint-staged": "eslint --cache --ext .ts ./src",
    "prepare": "husky install"
  },
  "lint-staged": {
    "**/*.ts": "yarn lint-staged"
  },
  "devDependencies": {
    "@babel/core": "7.14.x",
    "@babel/preset-env": "7.14.x",
    "@babel/preset-typescript": "7.14.x",
    "@types/jest": "26.0.x",
    "@types/node": "*",
    "@typescript-eslint/eslint-plugin": "4.28.x",
    "@typescript-eslint/parser": "4.28.x",
    "babel-jest": "27.0.x",
    "eslint": "7.30.x",
    "eslint-config-prettier": "8.3.x",
    "eslint-plugin-prettier": "3.4.x",
    "husky": "7.0.x",
    "jest": "27.0.x",
    "lint-staged": ">=10",
    "prettier": "2.3.x",
    "typescript": "4.8.x"
  }
}
