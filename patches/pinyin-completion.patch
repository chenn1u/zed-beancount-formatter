+/// 汉字转声母首字母缩写，非汉字的 ASCII 字母数字原样保留
+/// 与 Lencerf/vscode-beancount 的 pinyin 输入法一致：只取首字母，不是全拼
+fn pinyin_initials(text: &str) -> String {
+    let mut out = String::new();
+    for c in text.chars() {
+        match c.to_pinyin() {
+            Some(py) => out.push_str(py.first_letter()),
+            None if c.is_ascii_alphanumeric() => out.push(c),
+            None => {}
+        }
+    }
+    out
+}
+
+/// prefix 命中拼音首字母缩写时，返回 (缩写, 原始名称)，用于生成 `cg(餐馆)` 形式的候选
+fn pinyin_initial_matches(
+    candidates: &[String],
+    already_matched: &HashSet<&str>,
+    prefix: &str,
+) -> Vec<(String, String)> {
+    if prefix.is_empty() {
+        return Vec::new();
+    }
+    let needle = prefix.to_lowercase();
+    candidates
+        .iter()
+        .filter(|name| !already_matched.contains(name.as_str()))
+        .filter_map(|name| {
+            let initials = pinyin_initials(name);
+            (!initials.is_empty() && initials.to_lowercase().starts_with(&needle))
+                .then(|| (initials, name.clone()))
+        })
+        .collect()
+}
